# Local development environment (copy to .env and adjust)
# Real local PostgreSQL started with `pnpm db:up`
POSTGRES_URL="postgres://postgres:postgres@127.0.0.1:5432/postgres"
# Local embedded Postgres does not use TLS; hosted DBs (Vercel/Neon) need "require"
POSTGRES_SSL="false"

# NextAuth / Auth.js encryption secret — generate your own with: openssl rand -base64 32
AUTH_SECRET= FXKgknygSCTNpftZEJXJaVEpRYYi0I8n8aMG136Ui2I= 
AUTH_URL=http://localhost:3000/api/auth
