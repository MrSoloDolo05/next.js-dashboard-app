# Local development environment (copy to .env and adjust)
# Real local PostgreSQL started with `pnpm db:up`
POSTGRES_URL="postgres://postgres:postgres@127.0.0.1:5432/postgres"
# Local embedded Postgres does not use TLS; hosted DBs (Vercel/Neon) need "require"
POSTGRES_SSL="false"

# Supabase Auth (production data + RLS). Values live in the Supabase dashboard
# (Project Settings > API) and in Vercel env vars — never commit real values.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Demo logins are documented in README.md (usernames only, never passwords).
# Create demo users in the Supabase dashboard (Authentication > Users), then set
# their roles in public.profiles (e.g. role='admin' for the demo admin).
